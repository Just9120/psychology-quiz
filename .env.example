BOT_TOKEN=
BOT_USERNAME=
APP_ENV=dev
LOG_LEVEL=INFO
DB_PATH=/data/quiz.sqlite3
MINI_APP_URL=
ADMIN_TELEGRAM_IDS=
TELEGRAM_UPDATE_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_LISTEN=
TELEGRAM_WEBHOOK_PORT=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
CLASSIC_QUIZ_SEND_NEXT_AS_NEW_MESSAGE=false
CLASSIC_QUIZ_REPLY_KEYBOARD_MODE=false

# Owner PWA stays disabled until HTTPS routing and Yandex 360 are configured.
PWA_ENABLED=false
PWA_ORIGIN=
PWA_OWNER_EMAIL=
PWA_SMTP_HOST=
PWA_SMTP_PORT=465
PWA_SMTP_USERNAME=
PWA_SMTP_PASSWORD=
PWA_SMTP_FROM=
# Local development only; accepts HTTP on localhost/127.0.0.1/::1, never public hosts.
PWA_ALLOW_HTTP_LOCALHOST=false
